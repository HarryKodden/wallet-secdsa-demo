# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env

VERSION_TAG=stable
IMAGE_PREFIX=
# Optional: use CI-built issuer/verifier from this repo instead of Docker Hub waltid/*
# ISSUER_API2_IMAGE=ghcr.io/harrykodden/wallet-secdsa-demo/issuer-api2:latest
# VERIFIER_API2_IMAGE=ghcr.io/harrykodden/wallet-secdsa-demo/verifier-api2:latest
# Web wallet corner ribbon / Nuxt public version (use release tag in published images)
APP_VERSION=DEV

# How containers advertise issuer/wallet URLs (OID4VCI credential_issuer, etc.)
# SERVICE_HOST=host.docker.internal — reachable from wallet-api2 (extra_hosts).
# Browser: web-wallet rewrites authorize URL + Caddy rewrites Location → localhost.
# Register AS callback: http://localhost:7005/openid4vci/external/oauth/callback
SERVICE_HOST=host.docker.internal
PUBLIC_SERVICE_HOST=localhost

# Host ports (change if another stack already binds these)
SECDSA_HOST_PORT=18080
WALLET_API2_HOST_PORT=7006
ISSUER_API2_HOST_PORT=7005
VERIFIER_API2_HOST_PORT=7004
WEB_WALLET_HOST_PORT=7115

# Internal listen ports (keep stable — baked into images / Caddyfile)
SECDSA_PORT=8080
WALLET_API2_PORT=7006
ISSUER_API2_PORT=7005
VERIFIER_API2_PORT=7004
WEB_WALLET_PORT=7115

WSCA_INTERNAL_URL=http://secdsa:8080
WSCA_PUBLIC_URL=http://localhost:18080

# Postgres (local demo defaults — change for any shared deploy)
DB_NAME=waltid
DB_USERNAME=waltid
DB_PASSWORD=waltid
POSTGRES_DB_HOST=postgres

# Persist wallet-api2 login accounts across restarts (wallets/creds already in Postgres).
# Compose mounts volume wallet-api2-accounts at /data. Set to "none" to disable.
# WALLET2_ACCOUNT_STORE_PATH=/data/wallet2-accounts.json

# OIDC wallet *login* (web-wallet Nitro routes on :7115 — not wallet-api2)
# Register redirect URI: http://localhost:7115/wallet-api/auth/oidc-session
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Stable HMAC secret for OIDC → wallet-api2 JIT accounts (change for shared deploys)
OIDC_BRIDGE_SECRET=wallet-secdsa-demo-oidc-bridge-dev-only

# Optional Nuxt OIDC URL overrides (defaults match pilot)
# NUXT_PUBLIC_OIDC_AUTHORIZE_URL=https://oidc.pilot1.sram.surf.nl/authorize
# NUXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:7115/wallet-api/auth/oidc-session
# NUXT_OIDC_TOKEN_URL=https://oidc.pilot1.sram.surf.nl/token
# NUXT_PUBLIC_OIDC_SCOPES=openid email profile

# OID4VCI authorization_code grant (credential issuance — not wallet login)
# Register this redirect at the credential issuer's authorization server.
# On as.dev.eduid.nl allow scopes: openid  (optionally profile email / eduid.nl/*).
# Do NOT register wallet:read wallet:write api:read — those are unrelated demo scopes
# and cause invalid_scope (credential type is requested via authorization_details).
OID4VCI_CLIENT_ID=wallet-secdsa-demo
OID4VCI_REDIRECT_URI=http://localhost:7115/oid4vci/callback

# Local issuer user-login AS (issuer-api2 authentication-service.conf)
# Needed for Lab / local AUTHORIZED (authorization_code) offers.
# Flow: wallet → issuer /openid4vci/authorize → user logs in at this AS → back to wallet.
#
# Two different clients:
#   1) ISSUER_AS_*     — confidential client the *issuer* uses at the IdP (authorize + token + secret)
#   2) OID4VCI_*       — public wallet client at the *issuer’s* OID4VCI AS (client_id + redirect_uri)
#
# Keycloak example (realm myrealm):
#   ISSUER_AS_AUTHORIZE_URL=https://keycloak.example/realms/myrealm/protocol/openid-connect/auth
#   ISSUER_AS_TOKEN_URL=https://keycloak.example/realms/myrealm/protocol/openid-connect/token
#   ISSUER_AS_CLIENT_ID=issuer_api
#   ISSUER_AS_CLIENT_SECRET=...
# Defaults (if unset) = walt.id public demo Keycloak — fine for experiments, not a local AS.
# ISSUER_AS_NAME=keycloak
# ISSUER_AS_AUTHORIZE_URL=
# ISSUER_AS_TOKEN_URL=
# ISSUER_AS_CLIENT_ID=
# ISSUER_AS_CLIENT_SECRET=
# Set true in Lab UI to offer authorization_code once your AS is wired
# LAB_ENABLE_AUTH_CODE=false

# Local Lab (Scan page) — Nitro proxies to issuer/verifier; browser never calls these.
# Compose injects these by default for local demos. Unset / empty = hide the Lab UI.
# ISSUER_API2_INTERNAL_URL=http://issuer-api2:7005
# VERIFIER_API2_INTERNAL_URL=http://verifier-api2:7004
