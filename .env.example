# Copy to .env and adjust. Never commit .env.
#   cp .env.example .env

VERSION_TAG=stable
IMAGE_PREFIX=

# How containers advertise issuer/wallet URLs (OID4VCI credential_issuer, etc.)
SERVICE_HOST=host.docker.internal
PUBLIC_SERVICE_HOST=localhost

# Host ports (change if another stack already binds these)
SECDSA_HOST_PORT=18080
WALLET_API2_HOST_PORT=7006
ISSUER_API2_HOST_PORT=7005
VERIFIER_API2_HOST_PORT=7004
WEB_WALLET_HOST_PORT=7115

# Internal listen ports (keep stable — baked into images / Caddyfile)
SECDSA_PORT=8080
WALLET_API2_PORT=7006
ISSUER_API2_PORT=7005
VERIFIER_API2_PORT=7004
WEB_WALLET_PORT=7115

# SECDSA lab account (memory WSCD — educational only)
WSCA_ACCOUNT_ID=citizen-42
WSCA_PIN=424242
WSCA_INTERNAL_URL=http://secdsa:8080
WSCA_PUBLIC_URL=http://localhost:18080

# Postgres (local demo defaults — change for any shared deploy)
DB_NAME=waltid
DB_USERNAME=waltid
DB_PASSWORD=waltid
POSTGRES_DB_HOST=postgres

# SURF SRAM OIDC (web-wallet Nitro routes on :7115 — not wallet-api2)
# Register redirect URI: http://localhost:7115/wallet-api/auth/oidc-session
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Stable HMAC secret for OIDC → wallet-api2 JIT accounts (change for shared deploys)
OIDC_BRIDGE_SECRET=wallet-secdsa-demo-oidc-bridge-dev-only

# Optional Nuxt OIDC URL overrides (defaults match SURF pilot)
# NUXT_PUBLIC_OIDC_AUTHORIZE_URL=https://oidc.pilot1.sram.surf.nl/authorize
# NUXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:7115/wallet-api/auth/oidc-session
# NUXT_OIDC_TOKEN_URL=https://oidc.pilot1.sram.surf.nl/token
# NUXT_PUBLIC_OIDC_SCOPES=openid email profile
