# Copy to .env for `docker compose` (optional — defaults work for demos).
# Compose runs lab + adapter; the adapter reaches the lab on the Docker network.

# Path to HarryKodden/SECDSA checkout used to build the lab image (default: ../wsca)
# SECDSA_PATH=/absolute/path/to/wsca

# Host port published for the lab UI (http://localhost:${WSCA_PORT})
WSCA_PORT=8080

# Demo account / PIN (lab only — educational). Injected into the adapter service.
WSCA_ACCOUNT_ID=citizen-42
WSCA_PIN=424242

# Do NOT set WSCA_BASE_URL here for Compose — docker-compose.yml sets
#   WSCA_BASE_URL=http://lab:8080
# for the adapter container. Localhost only applies to host-side `./gradlew run`.
