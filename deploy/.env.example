# Public deploy — copy to .env and edit:
#   cp .env.example .env
#
# Images pulled from GHCR:
#   ghcr.io/harrykodden/wallet-secdsa-demo/{web-wallet,wallet-api2,issuer-api2,verifier-api2}:${VERSION_TAG}
# If packages are private:
#   echo "$GHCR_TOKEN" | docker login ghcr.io -u USER --password-stdin

# ---------------------------------------------------------------------------
# Image tag (required) — CI publishes: latest | vX.Y.Z | sha-<commit>
# ---------------------------------------------------------------------------
VERSION_TAG=latest

# Optional SECDSA lab image override
# SECDSA_IMAGE=ghcr.io/harrykodden/secdsa:latest

# ---------------------------------------------------------------------------
# Upstream bind (external reverse proxy connects here; TLS stays on the proxy)
# Default 127.0.0.1 = proxy on the same host. Use 0.0.0.0 only with a firewall.
# ---------------------------------------------------------------------------
BIND_ADDRESS=127.0.0.1
WALLET_API2_HOST_PORT=7006
ISSUER_API2_HOST_PORT=7005
VERIFIER_API2_HOST_PORT=7004
WEB_WALLET_HOST_PORT=7115

# ---------------------------------------------------------------------------
# Public HTTPS URLs — must match your reverse-proxy routing, e.g.:
#   https://wallet.example.com   → 127.0.0.1:7115  (web-wallet)
#   https://api.example.com      → 127.0.0.1:7006  (wallet-api2)
#   https://issuer.example.com   → 127.0.0.1:7005  (issuer-api2)
#   https://verifier.example.com → 127.0.0.1:7004  (verifier-api2)
# ---------------------------------------------------------------------------
PUBLIC_HOST=demo.example.com
SERVICE_HOST=demo.example.com

# Required for wallet-api2 (wallet-service.conf publicBaseUrl). Behind TLS use https.
# Do not leave blank — an empty value clears HOCON and crashes startup.
WALLET2_PUBLIC_BASE_URL=https://api.demo.example.com
ISSUER_PUBLIC_BASE_URL=https://issuer.demo.example.com
# Include the /verification-session path suffix
VERIFIER_PUBLIC_URL_PREFIX=https://verifier.demo.example.com/verification-session

# ---------------------------------------------------------------------------
# Secrets / database (change all of these)
# ---------------------------------------------------------------------------
DB_NAME=waltid
DB_USERNAME=waltid
DB_PASSWORD=change-me

OIDC_BRIDGE_SECRET=change-me-oidc-bridge
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Register redirect URIs at your IdP / issuer AS using the public wallet URL
NUXT_PUBLIC_OIDC_AUTHORIZE_URL=https://oidc.pilot1.sram.surf.nl/authorize
NUXT_OIDC_TOKEN_URL=https://oidc.pilot1.sram.surf.nl/token
NUXT_PUBLIC_OIDC_REDIRECT_URI=https://wallet.demo.example.com/wallet-api/auth/oidc-session
NUXT_PUBLIC_OIDC_SCOPES=openid email profile

OID4VCI_CLIENT_ID=wallet-secdsa-demo
OID4VCI_REDIRECT_URI=https://wallet.demo.example.com/oid4vci/callback

# ---------------------------------------------------------------------------
# SECDSA lab (in-memory WSCD — educational; not durable across secdsa restarts)
# ---------------------------------------------------------------------------
WSCA_ACCOUNT_ID=citizen-42
WSCA_PIN=424242
WSCA_INTERNAL_URL=http://secdsa:8080

# ---------------------------------------------------------------------------
# Optional: Local lab (Scan page issuer / verifier panels)
# Unset = panels hidden. Set to enable (services must be running).
# ---------------------------------------------------------------------------
# ISSUER_API2_INTERNAL_URL=http://issuer-api2:7005
# VERIFIER_API2_INTERNAL_URL=http://verifier-api2:7004

# Optional: Lab auth-code issuer AS (issuer-api2 → IdP)
# ISSUER_AS_NAME=keycloak
# ISSUER_AS_AUTHORIZE_URL=
# ISSUER_AS_TOKEN_URL=
# ISSUER_AS_CLIENT_ID=
# ISSUER_AS_CLIENT_SECRET=
# LAB_ENABLE_AUTH_CODE=false
